# Copy to .env and fill in your key. Never commit .env.

# ── OpenAI ───────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5-mini
TRIAGE_MODEL=gpt-5-mini
SPECIALIST_MODEL=gpt-5-mini
JUDGE_MODEL=gpt-5-mini
SAFETY_MODEL=gpt-5-mini
TEMPERATURE=0.2
REQUEST_TIMEOUT=60
MAX_RETRIES=3

# Set to false only behind a TLS-intercepting corporate proxy.
VERIFY_SSL=true

# ── Agents ───────────────────────────────────────────────
MAX_SPECIALISTS=10

# ── API ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
